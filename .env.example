# Supabase public client values (also configure as Cloudflare Worker variables)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Only for local account provisioning; NEVER configure as a Worker secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional PostgreSQL URL for integration tests only.
TEST_DATABASE_URL=
